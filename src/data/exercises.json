{
  "schemaVersion": 2,
  "appVersion": "0.24",
  "levels": [
    {
      "id": "level-1-foundations",
      "title": "Level 1 · Foundations",
      "description": "Build early decoding skills through short vowels, digraphs and simple sentences.",
      "units": [
        {
          "id": "unit-1-short-vowels",
          "title": "Unit 1 · Short Vowels",
          "description": "Hear, identify and build simple CVC words.",
          "lessons": [
            {
              "id": "lesson-1-short-a",
              "title": "Lesson 1 · Short A",
              "objective": "Recognize short /æ/ and build -AT words.",
              "activities": [
                {
                  "id": "activity-1-notice-a",
                  "title": "Hear & Notice",
                  "exercises": [
                    {
                      "id": "l1a-phoneme-a",
                      "type": "phoneme-match",
                      "title": "Match the vowel sound",
                      "instruction": "Which letter usually represents this short vowel sound?",
                      "display": "/æ/",
                      "answer": "A",
                      "choices": [
                        "A",
                        "E",
                        "I"
                      ],
                      "audio": "apple",
                      "examples": [
                        "CAT",
                        "MAP"
                      ],
                      "tags": [
                        "short-a",
                        "phoneme"
                      ]
                    },
                    {
                      "id": "l1a-missing-cat",
                      "type": "missing-letter",
                      "title": "Complete CAT",
                      "instruction": "Choose the missing vowel.",
                      "display": "C _ T",
                      "answer": "A",
                      "choices": [
                        "A",
                        "E",
                        "O"
                      ],
                      "audio": "CAT",
                      "emoji": "🐱",
                      "tags": [
                        "CVC",
                        "short-a"
                      ]
                    }
                  ]
                },
                {
                  "id": "activity-2-build-a",
                  "title": "Build & Read",
                  "exercises": [
                    {
                      "id": "l1a-build-cat",
                      "type": "word-build",
                      "title": "Build CAT",
                      "instruction": "Use the clue and arrange the letters.",
                      "clue": "A small animal that says “meow”.",
                      "emoji": "🐱",
                      "answer": [
                        "C",
                        "A",
                        "T"
                      ],
                      "bank": [
                        "T",
                        "C",
                        "A"
                      ],
                      "audio": "CAT",
                      "tags": [
                        "CVC",
                        "short-a"
                      ]
                    },
                    {
                      "id": "l1a-family-at",
                      "type": "word-family",
                      "title": "Find the -AT word",
                      "instruction": "Which word belongs to the -AT family?",
                      "display": "-AT",
                      "answer": "CAT",
                      "choices": [
                        "CAT",
                        "DOG",
                        "SUN"
                      ],
                      "emoji": "🐱",
                      "tags": [
                        "word-family",
                        "short-a"
                      ]
                    }
                  ]
                }
              ]
            },
